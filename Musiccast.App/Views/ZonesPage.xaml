<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Musiccast.App.Views.ZonesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Musiccast.App.Models"
    xmlns:helpers="using:Musiccast.App.Helpers"
    mc:Ignorable="d"> 

    <Page.Resources>
        <helpers:BooleanToColorConverter x:Key="BooleanToColorConverter" />
        <helpers:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
        <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />

        <DataTemplate x:Key="DeviceCardTemplate" x:DataType="models:Device">
            <Grid Width="400" Height="200" Margin="8"
                  CornerRadius="12"
                  Padding="8"
                  Opacity="{x:Bind IsOn, Converter={StaticResource BooleanToOpacityConverter}, Mode=OneWay}"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Active-state accent strip -->
                <Border Grid.RowSpan="3" 
                        Background="{x:Bind IsOn, Converter={StaticResource BooleanToColorConverter}, Mode=OneWay}"
                        CornerRadius="12" />

                <Grid Grid.Row="0" Padding="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind FriendlyName, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <ToggleButton Grid.Column="1"
                                  MinWidth="64"
                                  Command="{x:Bind TogglePowerCommand}"
                                  IsChecked="{x:Bind IsOn, Mode=OneWay}">
                        <TextBlock Text="{x:Bind IsOnString, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </ToggleButton>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Padding="8"
                            Orientation="Horizontal" Spacing="12">
                    <Border Width="80" Height="44" CornerRadius="8"
                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE768;" FontSize="20" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Input, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind SubTitle, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                Visibility="{x:Bind IsAlive, Converter={StaticResource InverseBooleanToVisibilityConverter}, Mode=OneWay}">
                        <FontIcon Glyph="&#xE8CD;" FontSize="14"
                                  Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock Text="Not found"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Zones" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Your MusicCast rooms and devices"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="20" Height="20" VerticalAlignment="Center" />
                <Button Command="{x:Bind ViewModel.AddDeviceCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Discover" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ClearDevicesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <GridView x:Name="DevicesGrid"
                      ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                      ItemTemplate="{StaticResource DeviceCardTemplate}"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="DevicesGrid_ItemClick">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>
        </ScrollViewer>
    </Grid>
</Page>
